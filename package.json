{
  "name": "pi-pr-alerts",
  "version": "0.1.0",
  "description": "A Pi extension forked from pi-pr-status that shows PR status and alerts the agent on CI failures or new PR comments",
  "author": "Noah Horton",
  "license": "MIT",
  "homepage": "https://github.com/nhorton/pi-pr-alerts#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nhorton/pi-pr-alerts"
  },
  "keywords": [
    "pi-package",
    "github",
    "pull-request",
    "ci",
    "pi-extension",
    "alerts"
  ],
  "files": [
    "extensions/pr-status.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.76.0",
    "@earendil-works/pi-tui": "^0.76.0",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit --skipLibCheck --module nodenext --moduleResolution nodenext --target es2022 --types node extensions/pr-status.ts",
    "pack:dry": "npm pack --dry-run"
  }
}
